{
  "name": "@langr/sdk",
  "version": "1.1.0",
  "description": "Official TypeScript SDK for the LANGR API (api.langr.org)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "langr", "api", "sdk", "email-api", "transactional-email",
    "sms-api", "sms-otp", "otp-verification", "auth-api",
    "payment-api", "seo-api", "i18n", "translation-api",
    "multilingual", "resend-alternative", "sendgrid-alternative",
    "twilio-alternative", "typescript", "nodejs"
  ],
  "author": "LANGR <hikmet@langr.dk>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiko1981/langr-sdk.git"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
